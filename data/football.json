name: Actualizar datos BETPRO

on:
  workflow_dispatch:
  schedule:
    - cron: "17 6 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Obtener partidos reales de API-Football
        env:
          API_FOOTBALL_KEY: ${{ secrets.API_FOOTBALL_KEY }}
        run: |
          node <<'NODE'
          const fs = require("fs");
          const key = process.env.API_FOOTBALL_KEY;
          if (!key) throw new Error("Falta el secreto API_FOOTBALL_KEY");

          const leagues = [
            [140, "LaLiga"],
            [39, "Premier League"],
            [135, "Serie A"],
            [78, "Bundesliga"],
            [141, "Segunda División"]
          ];
          const season = 2026;

          async function get(url) {
            const r = await fetch(url, {
              headers: { "x-apisports-key": key }
            });
            if (!r.ok) throw new Error("HTTP " + r.status);
            const j = await r.json();
            if (j.errors && Object.keys(j.errors).length) {
              throw new Error(JSON.stringify(j.errors));
            }
            return j.response || [];
          }

          (async () => {
            const games = [];

            for (const [league, name] of leagues) {
              for (const mode of ["last=10", "next=10"]) {
                const url =
                  "https://v3.football.api-sports.io/fixtures" +
                  "?league=" + league +
                  "&season=" + season +
                  "&" + mode;

                try {
                  const items = await get(url);
                  for (const x of items) {
                    games.push({
                      id: x.fixture.id,
                      league: name,
                      date: x.fixture.date,
                      status: x.fixture.status.short,
                      home: x.teams.home.name,
                      away: x.teams.away.name,
                      homeScore: x.goals.home,
                      awayScore: x.goals.away
                    });
                  }
                } catch (e) {
                  console.log("Error en " + name + " (" + mode + "): " + e.message);
                }
              }
            }

            const unique = [...new Map(games.map(x => [x.id, x])).values()];
            unique.sort((a, b) => new Date(a.date) - new Date(b.date));

            fs.mkdirSync("data", { recursive: true });
            fs.writeFileSync(
              "data/football.json",
              JSON.stringify({
                updatedAt: new Date().toISOString(),
                source: "API-Football",
                season,
                games: unique
              }, null, 2)
            );

            console.log("BETPRO: " + unique.length + " partidos guardados");
          })().catch(err => {
            console.error(err);
            process.exit(1);
          });
          NODE

      - name: Comprobar archivo generado
        run: |
          test -f data/football.json
          ls -lh data/football.json
          head -c 500 data/football.json
          echo

      - name: Guardar datos en GitHub
        run: |
          git config user.name "BETPRO Bot"
          git config user.email "actions@users.noreply.github.com"
          git add -f data/football.json
          git status --short
          if git diff --cached --quiet; then
            echo "No hay cambios que guardar."
          else
            git commit -m "Actualizar datos reales de fútbol"
            git push origin principal
          fi
            
